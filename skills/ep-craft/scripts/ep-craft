#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Thin checkout shim: run the packaged CLI without installing it.

The implementation lives in ``skills/ep-craft/src/ep_craft``. This file only
bootstraps that source directory onto ``sys.path``, then calls the same
``ep_craft.cli.main`` that the installed console script uses.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))

from ep_craft.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(canvas=True))
